{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行任务清单 (app.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "PORT": "8000"
      }
    }
  ]
}
